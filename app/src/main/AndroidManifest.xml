<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions: none. Files move in and out through the system file picker and share sheet
  (Storage Access Framework / FileProvider), which need no permissions. Add permissions only
  when a feature truly requires one, and document why next to it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ConstructionCalcApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConstructionCalc">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open project or backup JSON and complete project ZIP files. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!-- "Share to Construction Calc" from another app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>
    </application>

</manifest>
