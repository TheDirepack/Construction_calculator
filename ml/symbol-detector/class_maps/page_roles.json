{
  "_comment": [
    "Role of every raw source page, first matching rule wins. Globs are relative to the data root.",
    "background  = UNVERIFIED source for synthetic/SSL use; it may contain real electrical symbols and MUST NOT be used as a supervised negative.",
    "label_queue = has REAL electrical symbols with no labels: model proposals + human review, never trained on as-is.",
    "asset       = symbol library (shapes to composite), not a page.",
    "auto_text   = text-match pages go to label_queue; no text match goes to UNVERIFIED background, never a trusted negative.",
    "skip        = not useful for plan symbols.",
    "group: 'file' = each file is its own project; 'set:<name>' = all matches are one project (one split);",
    "       'dir:N' = first N path parts (one project per folder); 'regex:<pat>' = group(1) of the file stem.",
    "       'series' = files named <series>-<n>-<hash> share a project.",
    "pages: per-page routing hints for scanned PDFs (1-based, ranges allowed); not exhaustive presence attestations."
  ],
  "electrical_words": [
    "ELECTRICAL",
    "POWER PLAN",
    "LIGHTING",
    "RECEPTACLE",
    "OUTLET",
    "PANELBOARD",
    "PANEL SCHEDULE",
    "SWITCH",
    "LUMINAIRE",
    "FIRE ALARM",
    "ONE-LINE",
    "ONE LINE",
    "RISER",
    "CIRCUIT",
    "JUNCTION BOX",
    "SYMBOL LEGEND",
    "DUPLEX",
    "GFCI",
    "GFI",
    "DISCONNECT"
  ],
  "rules": [
    {
      "glob": "1_blueprints/devices/**",
      "role": "skip",
      "why": "extracted DEVICES.json files and the label store (pages rendered from PDFs already in the pool)"
    },
    {
      "glob": "field_panels_album_2/**",
      "role": "skip",
      "why": "photos of panelboards, not plan symbols"
    },
    {
      "glob": "field_plans_album_1/**",
      "role": "label_queue",
      "group": "set:field_album_1",
      "why": "RCP, lighting layouts and electrical redlines (moved out of 1_blueprints)"
    },
    {
      "glob": "_recovered_from_pool/**",
      "role": "skip",
      "why": "copies of images already in the page pool"
    },
    {
      "glob": "_device_audit_crops/**",
      "role": "skip",
      "why": "audit crops, not pages"
    },
    {
      "glob": "_snap_reference/**",
      "role": "skip",
      "why": "reference images for the app's line snapping"
    },
    {
      "glob": "1_blueprints/field_panels_album_2/**",
      "role": "skip",
      "why": "photos of panelboards, not plan symbols"
    },
    {
      "glob": "1_blueprints/field_plans_album_1/**",
      "role": "label_queue",
      "group": "set:field_album_1",
      "why": "RCP, lighting layouts and electrical redlines"
    },
    {
      "glob": "1_blueprints/rinker_hall/electrical/**",
      "role": "label_queue",
      "group": "set:rinker_hall"
    },
    {
      "glob": "1_blueprints/rinker_hall/fire_protection/**",
      "role": "label_queue",
      "group": "set:rinker_hall"
    },
    {
      "glob": "1_blueprints/rinker_hall/**",
      "role": "auto_text",
      "group": "set:rinker_hall"
    },
    {
      "glob": "1_blueprints/user_scans/njatc_manufacturing_plant.pdf",
      "role": "background",
      "group": "set:njatc_plant",
      "pages": {
        "23": "label_queue",
        "26-49": "label_queue"
      },
      "why": "1 cover, 2-3 civil, 4-11 arch, 12 struct, 13-24 mech (23 = control diagrams), 25 plumbing, 26-49 electrical E1-E23"
    },
    {
      "glob": "1_blueprints/user_scans/**",
      "role": "label_queue",
      "group": "file",
      "why": "new scans default to review until their sheets are classified here"
    },
    {
      "glob": "1_blueprints/freefarmhouse/**",
      "role": "auto_text",
      "group": "set:freefarmhouse"
    },
    {
      "glob": "1_blueprints/wikimedia_us_drawings/Architect and engineer _1920_ _14782667522_.jpg",
      "role": "skip",
      "why": "excluded by 1_blueprints/EXCLUSION_ANALYSIS.json (trade periodical article page, not a plan)"
    },
    {
      "glob": "1_blueprints/wikimedia_us_drawings/**",
      "role": "background",
      "group": "set:wikimedia_us_drawings",
      "why": "crops and sheet series of the same buildings"
    },
    {
      "glob": "1_blueprints/new_downloads_202611*/**/*SPECS*",
      "role": "skip",
      "why": "specification volumes, not drawing sheets"
    },
    {
      "glob": "1_blueprints/new_downloads_202611*/**/*RFP*",
      "role": "skip",
      "why": "RFP text documents, not drawing sheets"
    },
    {
      "glob": "1_blueprints/new_downloads_202611*/**/page_texts/**",
      "role": "skip",
      "why": "extracted text dumps"
    },
    {
      "glob": "1_blueprints/new_downloads_202611*/**",
      "role": "auto_text",
      "group": "file",
      "why": "complete bid/construction drawing sets: route electrical sheets to label_queue, others to background"
    },
    {
      "glob": "1_blueprints/library_of_congress/**",
      "role": "background",
      "group": "set:library_of_congress"
    },
    {
      "glob": "1_blueprints/photocad_architecture/**",
      "role": "background",
      "group": "file"
    },
    {
      "glob": "1_blueprints/evaluation/**",
      "role": "skip",
      "why": "locked detector evaluation set; never rendered into a training pool"
    },
    {
      "glob": "1_blueprints/**",
      "role": "background",
      "group": "file"
    },
    {
      "glob": "2_component_libraries/innerscene_cad_library/*symbol*",
      "role": "asset"
    },
    {
      "glob": "2_component_libraries/innerscene_cad_library/*electrical*",
      "role": "label_queue",
      "group": "series"
    },
    {
      "glob": "2_component_libraries/innerscene_cad_library/*pwr*",
      "role": "label_queue",
      "group": "series"
    },
    {
      "glob": "2_component_libraries/innerscene_cad_library/*lghtng*",
      "role": "label_queue",
      "group": "series"
    },
    {
      "glob": "2_component_libraries/innerscene_cad_library/*lighting*",
      "role": "label_queue",
      "group": "series"
    },
    {
      "glob": "2_component_libraries/innerscene_cad_library/*wiring*",
      "role": "label_queue",
      "group": "series"
    },
    {
      "glob": "2_component_libraries/innerscene_cad_library/*schematic*",
      "role": "label_queue",
      "group": "series"
    },
    {
      "glob": "2_component_libraries/innerscene_cad_library/**",
      "role": "background",
      "group": "series"
    },
    {
      "glob": "2_component_libraries/**",
      "role": "asset"
    },
    {
      "glob": "3_open_source_architecture/**",
      "role": "background",
      "group": "dir:2",
      "why": "parts of one design (e.g. SKYLARK150 vs 200) stay in one split"
    },
    {
      "glob": "4_archives/state_dot_samples/**",
      "role": "auto_text",
      "group": "file"
    },
    {
      "glob": "4_archives/loc_habs_haer_hals/**",
      "role": "background",
      "group": "regex:^([a-z]{2}\\d{3})",
      "why": "site ids like ak0631/ak0632 are neighbouring buildings of one survey"
    },
    {
      "glob": "4_archives/uw_cities_and_buildings_full/**",
      "role": "skip",
      "why": "excluded by 4_archives/uw_cities_and_buildings_full/EXCLUSION_ANALYSIS.json (10,893 building photos, 0 blueprints)"
    },
    {
      "glob": "4_archives/uw_cities_and_buildings/**",
      "role": "background",
      "group": "regex:^\\d+_(.+)$",
      "why": "numbered photos of the same building"
    },
    {
      "glob": "4_archives/**",
      "role": "background",
      "group": "file"
    },
    {
      "glob": "5_datasets/floorplancad_sample/**",
      "role": "skip",
      "why": "imported with its labels by adapters/import_floorplancad_fiftyone.py"
    },
    {
      "glob": "5_datasets/google_open_buildings_sample/**",
      "role": "skip",
      "why": "satellite footprints, not drawings"
    },
    {
      "glob": "5_datasets/**",
      "role": "skip",
      "why": "vector layouts are rendered by adapters/render_layouts.py"
    }
  ]
}
